# ---------------------------------------------------------------------------
# Copy to .env.local for local work. Never commit real values: this project
# handles special-category personal data.
# ---------------------------------------------------------------------------

# Neon Postgres, Frankfurt region. Use the POOLED connection string.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/eture_photos?sslmode=require

# Cloudflare R2. Create an API token scoped to this one bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eture-photos

# ---------------------------------------------------------------------------
# Phase 2 — face recognition. Leave blank until the AWS account is ready.
# The pipeline runs without these: uploads, de-duplication, derivatives and
# session assignment all work; only recognition is skipped.
#
# Use eu-west-1 (Ireland) so biometric processing stays inside the EU.
# ---------------------------------------------------------------------------
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_COLLECTION_ID=eture-2526

# ---------------------------------------------------------------------------
# Inngest. Taken from the Inngest dashboard once the app is connected.
# Not needed for `npx inngest-cli dev` locally.
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
